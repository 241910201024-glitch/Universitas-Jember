        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "import librosa\n",
        "import soundfile as sf\n",
        "import noisereduce as nr\n",
        "\n",
        "from scipy.signal import butter, sosfiltfilt\n",
        "from scipy.fft import fft, fftfreq\n",
        "\n",
        "from IPython.display import Audio\n",
        "from google.colab import files\n",
        "\n",
        "uploaded = files.upload()\n",
        "\n",
        "audio_file = list(uploaded.keys())[0]\n",
        "\n",
        "signal, sr = librosa.load(audio_file, sr=None)\n",
        "\n",
        "print(\"Nama File :\", audio_file)\n",
        "print(\"Sampling Rate :\", sr, \"Hz\")\n",
        "\n",
        "def get_fft(data, sr):\n",
        "\n",
        "    N = len(data)\n",
        "\n",
        "    # WINDOWING\n",
        "    window = np.hanning(N)\n",
        "    data_window = data * window\n",
        "\n",
        "    yf = fft(data_window)\n",
        "    xf = fftfreq(N, 1/sr)\n",
        "\n",
        "    freq = xf[:N//2]\n",
        "    magnitude = np.abs(yf[:N//2])\n",
        "\n",
        "    return freq, magnitude\n",
        "\n",
        "freq_asli, mag_asli = get_fft(signal, sr)\n",
        "\n",
        "order = 4\n",
        "\n",
        "lowcut = 200\n",
        "highcut = 3400\n",
        "\n",
        "nyquist = 0.5 * sr\n",
        "\n",
        "low = lowcut / nyquist\n",
        "high = highcut / nyquist\n",
        "\n",
        "sos = butter(order, [low, high], btype='bandpass', output='sos')\n",
        "\n",
        "filtered_signal = nr.reduce_noise(y=filtered_signal, sr=sr, stationary=False)\n",
        "\n",
        "freq_info, mag_info = get_fft(filtered_signal, sr)\n",
        "noise_signal = signal - filtered_signal\n",
        "freq_noise, mag_noise = get_fft(noise_signal, sr)\n",
        "plt.figure(figsize=(14,5))\n",
        "\n",
        "plt.plot(freq_asli,\n",
        "         mag_asli)\n",
        "\n",
        "plt.title(\"FFT Frekuensi Asli + Noise\")\n",
        "plt.xlabel(\"Frekuensi (Hz)\")\n",
        "plt.ylabel(\"Magnitudo\")\n",
        "\n",
        "plt.xlim(0, 5000)\n",
        "\n",
        "plt.grid()\n",
        "plt.show()\n",
        "\n",
        "plt.figure(figsize=(14,5))\n",
        "\n",
        "plt.plot(freq_info, mag_info, color='orange')\n",
        "\n",
        "plt.title(\"FFT Frekuensi Sinyal Informasi\")\n",
        "plt.xlabel(\"Frekuensi (Hz)\")\n",
        "plt.ylabel(\"Magnitudo\")\n",
        "\n",
        "plt.xlim(0, 5000)\n",
        "\n",
        "plt.grid()\n",
        "plt.show()\n",
        "\n",
        "plt.figure(figsize=(14,5))\n",
        "\n",
        "plt.plot(freq_noise,\n",
        "         mag_noise)\n",
        "\n",
        "plt.title(\"FFT Frekuensi Noise\")\n",
        "plt.xlabel(\"Frekuensi (Hz)\")\n",
        "plt.ylabel(\"Magnitudo\")\n",
        "\n",
        "plt.xlim(0, 5000)\n",
        "\n",
        "plt.grid()\n",
        "plt.show()\n",
        "\n",
        "mag_info_norm = mag_info / np.max(mag_info)\n",
        "mag_noise_norm = mag_noise / np.max(mag_noise)\n",
        "\n",
        "plt.figure(figsize=(14,5))\n",
        "\n",
        "plt.plot(freq_info, mag_info_norm, color='orange', linewidth=2, label='Sinyal Informasi')\n",
        "plt.plot(freq_noise, mag_noise_norm, color='blue', alpha=0.5, label='Noise')\n",
        "\n",
        "plt.title(\"Perbandingan FFT Sinyal Informasi dan Noise\")\n",
        "plt.xlabel(\"Frekuensi (Hz)\")\n",
        "plt.ylabel(\"Magnitudo Normalisasi\")\n",
        "\n",
        "plt.xlim(0, 5000)\n",
        "\n",
        "plt.legend()\n",
        "plt.grid()\n",
        "\n",
        "plt.show()\n",
        "\n",
        "sf.write(\"hasil_filter_adzan.wav\", filtered_signal, sr)\n",
        "\n",
        "print(\"Audio hasil filter berhasil disimpan!\")\n",
        "print(\"Audio Setelah Filter\")\n",
        "display(Audio(filtered_signal, rate=sr))\n"
