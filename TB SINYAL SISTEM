        "    plt.show()\n",
        "\n",
        "def plot_fft(data, sr, title, max_freq=5000):\n",
        "\n",
        "    N = len(data)\n",
        "\n",
        "    window = np.hanning(N)\n",
        "    data = data * window\n",
        "\n",
        "    yf = fft(data)\n",
        "    xf = fftfreq(N, 1/sr)\n",
        "\n",
        "    freq = xf[:N//2]\n",
        "    magnitude = np.abs(yf[:N//2])\n",
        "\n",
        "    plt.figure(figsize=(14,5))\n",
        "\n",
        "    plt.plot(freq, magnitude)\n",
        "\n",
        "    plt.title(title)\n",
        "    plt.xlabel(\"Frekuensi (Hz)\")\n",
        "    plt.ylabel(\"Magnitudo\")\n",
        "\n",
        "    plt.xlim(0, max_freq)\n",
        "\n",
        "    plt.grid()\n",
        "    plt.show()\n",
